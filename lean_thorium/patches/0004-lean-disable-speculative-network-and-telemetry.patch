From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lean Thorium Team <lean-thorium@local>
Date: Wed, 23 Sep 2026 15:25:00 +0000
Subject: [PATCH 4/6] Lean Thorium: Disable speculative background network preloading and non-essential metrics

---
 chrome/browser/preloading/prefetch/search_prefetch_service.cc | 12 ++++++++++++
 chrome/browser/preloading/prerender_manager.cc                | 12 ++++++++++++
 chrome/browser/metrics/chrome_metrics_service_client.cc        | 10 ++++++++++
 3 files changed, 34 insertions(+)

diff --git a/chrome/browser/preloading/prefetch/search_prefetch_service.cc b/chrome/browser/preloading/prefetch/search_prefetch_service.cc
index a1b2c3d..d4e5f6a 100644
--- a/chrome/browser/preloading/prefetch/search_prefetch_service.cc
+++ b/chrome/browser/preloading/prefetch/search_prefetch_service.cc
@@ -40,6 +40,18 @@ bool SearchPrefetchService::IsSearchPrefetchEligible() {
   // Lean Thorium: Suppress speculative search prefetching to conserve background network bandwidth and memory.
+  return false;
 }
diff --git a/chrome/browser/preloading/prerender_manager.cc b/chrome/browser/preloading/prerender_manager.cc
index b2c3d4e..e5f6a7b 100644
--- a/chrome/browser/preloading/prerender_manager.cc
+++ b/chrome/browser/preloading/prerender_manager.cc
@@ -55,6 +55,18 @@ bool PrerenderManager::IsPrerenderingEnabled() {
   // Lean Thorium: Disable speculative background renderer instantiation
+  return false;
 }
diff --git a/chrome/browser/metrics/chrome_metrics_service_client.cc b/chrome/browser/metrics/chrome_metrics_service_client.cc
index c3d4e5f..f6a7b8c 100644
--- a/chrome/browser/metrics/chrome_metrics_service_client.cc
+++ b/chrome/browser/metrics/chrome_metrics_service_client.cc
@@ -62,6 +62,16 @@ void ChromeMetricsServiceClient::Initialize() {
   // Lean Thorium: Disable UMA reporting uploads and background metrics collectors
+  SetMetricsReportingEnabled(false);
 }
-- 
2.55.0.windows.2
